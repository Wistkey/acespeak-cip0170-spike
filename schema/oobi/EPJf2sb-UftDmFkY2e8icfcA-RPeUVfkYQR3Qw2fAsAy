{
  "$id": "EPJf2sb-UftDmFkY2e8icfcA-RPeUVfkYQR3Qw2fAsAy",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AceSpeak Communication Credential Profile",
  "description": "A minimal, non-identifying attestation that a learner reached a defined spoken-communication standard. Deliberately carries no video, transcript, personal information or raw score: the assessment evidence stays private and is referenced only by digest. Draft v1 — the open profile promised in section 6 of the AceSpeak Catalyst pilot plan.",
  "credentialType": "CommunicationCredential",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "v",
    "d",
    "i",
    "s",
    "a"
  ],
  "properties": {
    "v": {
      "description": "ACDC version string",
      "type": "string"
    },
    "d": {
      "description": "Credential SAID",
      "type": "string"
    },
    "u": {
      "description": "Optional salty nonce, blinding the credential against correlation",
      "type": "string"
    },
    "i": {
      "description": "Issuer AID — AceSpeak's declared identifier",
      "type": "string"
    },
    "ri": {
      "description": "Credential status registry identifier",
      "type": "string"
    },
    "s": {
      "description": "Schema SAID",
      "type": "string"
    },
    "a": {
      "oneOf": [
        {
          "description": "Attributes block SAID",
          "type": "string"
        },
        {
          "$id": "EPurro5t-v-6ufKHLZGZla7VtMrktmPXBpysoKffrTcm",
          "description": "Attributes block",
          "type": "object",
          "required": [
            "d",
            "i",
            "dt",
            "credentialType",
            "schemaVersion"
          ],
          "properties": {
            "d": {
              "description": "Attributes block SAID",
              "type": "string"
            },
            "i": {
              "description": "Issuee AID, or an opaque holder reference where the learner holds no AID",
              "type": "string"
            },
            "dt": {
              "description": "Issuance date-time",
              "type": "string",
              "format": "date-time"
            },
            "credentialType": {
              "description": "The event being attested: an identity bind, a speaking baseline, a monthly progress attestation, or completion of one of the four achievement pathways.",
              "type": "string",
              "enum": [
                "LearnerIdentity",
                "SpeakingBaseline",
                "MonthlyProgress",
                "InterviewReady",
                "PresentationReady",
                "OralCommunication",
                "PitchReady"
              ]
            },
            "schemaVersion": {
              "description": "Version of the Communication Credential Profile this credential follows",
              "type": "string"
            },
            "holderRef": {
              "description": "Opaque, salted digest of the learner's internal identifier. Not reversible and not correlatable across salts.",
              "type": "string"
            },
            "evidenceDigest": {
              "description": "CESR digest of the private assessment record held off-chain by AceSpeak. Lets a holder prove which assessment backs the credential without revealing it.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "e": {
      "description": "Edge block, chaining this credential to the issuer's authority credential",
      "type": "object"
    },
    "r": {
      "description": "Rules block",
      "type": "object"
    }
  },
  "additionalProperties": false
}
