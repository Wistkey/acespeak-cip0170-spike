# --- KERI -------------------------------------------------------------------
# Passcode that derives the issuer's signing keys. Generate once with
# `npm run incept`, then store it in a password manager — NOT in this repo.
# Losing it loses the declared identifier.
KERI_BRAN=

# Local KERIA agent from signify-ts' docker-compose.
KERIA_URL=http://127.0.0.1:3901
KERIA_BOOT_URL=http://127.0.0.1:3903

# --- Cardano ----------------------------------------------------------------
# Blockfrost preprod project key: https://blockfrost.io
BLOCKFROST_PROJECT_ID=

# Two independently faucet-funded preprod wallets. These MUST NOT fund each
# other — the whole point of the spike is that the ATTEST fee is paid by a
# wallet that is not AceSpeak's.
ISSUER_MNEMONIC=
LEARNER_MNEMONIC=
